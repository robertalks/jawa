<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detail_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Top bar: back + place, last update (tap to refresh), settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/place_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="←  Weather"
                android:textColor="#D9FFFFFF"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="#BFFFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/settings"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Settings"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#BFFFFFFF"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Places: tap one, or swipe left/right anywhere on the screen -->
        <HorizontalScrollView
            android:id="@+id/pills_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/pills_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Current weather -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/cur_icon"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wx_partly_day" />
            <TextView
                android:id="@+id/cur_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:text="--°"
                android:textColor="#FFFFFF"
                android:textSize="72sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/cur_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/cur_feels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/cur_hl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/detail_dots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="-8dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/detail_chip"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="6dp"
                android:paddingBottom="8dp">
                <TextView style="@style/DetailChipLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wind" />
                <TextView android:id="@+id/chip_wind" style="@style/DetailChipValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/detail_chip"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="6dp"
                android:paddingBottom="8dp">
                <TextView style="@style/DetailChipLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rain today" />
                <TextView android:id="@+id/chip_rain" style="@style/DetailChipValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/detail_chip"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="6dp"
                android:paddingBottom="8dp">
                <TextView style="@style/DetailChipLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sunrise" />
                <TextView android:id="@+id/chip_sunrise" style="@style/DetailChipValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/detail_chip"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="6dp"
                android:paddingBottom="8dp">
                <TextView style="@style/DetailChipLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sunset" />
                <TextView android:id="@+id/chip_sunset" style="@style/DetailChipValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" />
            </LinearLayout>
        </LinearLayout>

        <!-- Next 24 hours -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/detail_card"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">
            <TextView
                style="@style/DetailCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp"
                android:text="Next hours" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/hours_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 14 days -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/detail_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">
            <TextView
                style="@style/DetailCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:text="14 days" />
            <LinearLayout
                android:id="@+id/days_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0.45"
            android:gravity="center"
            android:text="Weather data by Open-Meteo.com"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
